# Contoh konfigurasi Agenda Guru v0.2 — salin menjadi ".env" lalu sesuaikan.
# Wizard /install dapat membuat file ini otomatis. JANGAN commit/membagikan .env.

#database.default.hostname = 127.0.0.1
#database.default.database = u917227986_simguruv2
#database.default.username = u917227986_simagendaguru
#database.default.password = DetQv1Jy|
#database.default.DBDriver = MySQLi

CI_ENVIRONMENT = production

# URL lengkap aplikasi, diakhiri "/". Kosongkan untuk deteksi otomatis (tidak disarankan di produksi).
app.baseURL = "https://contoh-sekolah.sch.id/agenda/"
# true bila situs memakai HTTPS (disarankan)
app.forceGlobalSecureRequests = true
cookie.secure = true

# --- MariaDB / MySQL ---
database.default.hostname = "localhost"
database.default.database = "nama_database"
database.default.username = "user_database"
database.default.password = "password_database"
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# --- PostgreSQL (pilih salah satu engine) ---
# database.default.DBDriver = Postgre
# database.default.port = 5432
# database.default.charset = utf8
# database.default.DBCollat =

# Buat dengan: php spark key:generate --show
encryption.key =

logger.threshold = 4

#--------------------------------------------------------------------
# PEMBATAS AKSES (anti tebak sandi & banjir permintaan)
#--------------------------------------------------------------------
# Batas per alamat IP. Bila semua guru memakai satu Wi-Fi sekolah (IP publik sama),
# naikkan perMinute (mis. 300). Untuk DDoS besar gunakan perlindungan hosting/Cloudflare.
accesslimit.enabled         = true
accesslimit.perMinute       = 120
accesslimit.login           = 10/300
accesslimit.upload          = 20/60
# Pisahkan dengan koma, boleh pakai * di akhir (mis. 10.0.0.*)
accesslimit.blockedIps      =
# Kosong = admin boleh login dari mana saja; isi IP publik sekolah untuk membatasi
accesslimit.adminAllowedIps =

#--------------------------------------------------------------------
# CEK PEMBARUAN dari repo GitHub PRIVATE (opsional)
#--------------------------------------------------------------------
# Alamat rilis dikunci di app/Config/AppUpdate.php (tidak bisa diubah dari aplikasi).
# Fine-grained token: hanya repo aplikasi ini, izin "Contents: Read-only".
# true = "Cek pembaruan" langsung memasang versi baru (backup, pasang, migrasi). false = hanya memberi tahu.
appupdate.autoInstall = true
appupdate.githubToken =
